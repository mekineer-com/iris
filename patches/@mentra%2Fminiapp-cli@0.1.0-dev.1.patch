+export async function readReleaseBundle(path: string) {
+  if (!existsSync(path)) throw new Error(`Release bundle not found: ${path}`)
+  const zipBuffer = readFileSync(path)
+  const zip = await JSZip.loadAsync(zipBuffer)
+  const manifestFile = zip.file('miniapp.json')
+  if (!manifestFile) throw new Error('Release bundle is missing miniapp.json')
+  const manifestBuffer = Buffer.from(await manifestFile.async('uint8array'))
+  const iconFile = zip.file('icon.png')
+  return {
+    zipBuffer,
+    manifestBuffer,
+    iconBuffer: iconFile ? Buffer.from(await iconFile.async('uint8array')) : null,
+  }
 }

