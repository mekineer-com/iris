+import {expect, test} from 'bun:test'
+import {mkdtempSync, readFileSync, rmSync, writeFileSync} from 'fs'
+import {tmpdir} from 'os'
+import {join, resolve} from 'path'
+import JSZip from 'jszip'
+
+import {readReleaseBundle, seedReleaseBundle} from './release'
+
+test('reads identity and icon from a prebuilt release', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'mentra-release-'))
+  try {
+    const path = join(dir, 'bundle.zip')
+    const zip = new JSZip()
+    zip.file('miniapp.json', JSON.stringify({packageName: 'com.example.app', version: '1.2.3'}))
+    zip.file('icon.png', new Uint8Array([1, 2, 3]))
+    writeFileSync(path, await zip.generateAsync({type: 'uint8array'}))
+
+    const bundle = await readReleaseBundle(path)
+    expect(JSON.parse(bundle.manifestBuffer.toString())).toEqual({packageName: 'com.example.app', version: '1.2.3'})
+    expect(bundle.iconBuffer).toEqual(Buffer.from([1, 2, 3]))
+  } finally {
+    rmSync(dir, {recursive: true, force: true})
+  }
+})
+
+test('seeds the served background before its entrypoint without changing the base ZIP', async () => {
+  const zip = new JSZip()
+  zip.file('miniapp.json', JSON.stringify({entry: {background: 'dist/background.js'}}))
+  zip.file('dist/background.js', '(function(){globalThis.loadedDefaults = globalThis.__OPENALMA_INSTALL_DEFAULTS__})()')
+  zip.file('dist/ui.js', 'unchanged UI')
+  const original = await zip.generateAsync({type: 'nodebuffer'})
+  const defaults = {baseUrl: 'http://test.example', userId: 'Test "User"', deviceSessionId: 'stock-test'}
+  const served = await JSZip.loadAsync(await seedReleaseBundle(original, defaults))
+  const script = await served.file('dist/background.js')!.async('string')
+  const scope: Record<string, unknown> = {}
+  new Function('globalThis', script)(scope)
+  expect(scope.loadedDefaults).toEqual(defaults)
+  expect(await served.file('dist/ui.js')!.async('string')).toBe('unchanged UI')
+  expect(await (await JSZip.loadAsync(original)).file('dist/background.js')!.async('string')).not.toContain('__OPENALMA_INSTALL_DEFAULTS__ =')
+})
+
+test('serves defaults for either host but automatic offers and acknowledgements only for the fork', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'mentra-offer-'))
+  try {
+    const zip = new JSZip()
+    const manifest = JSON.parse(readFileSync(resolve('miniapp.json'), 'utf8'))
+    zip.file('miniapp.json', JSON.stringify(manifest))
+    zip.file(manifest.entry.background, '(function(){globalThis.loadedDefaults = globalThis.__OPENALMA_INSTALL_DEFAULTS__})()')
+    const path = join(dir, 'bundle.zip')
+    writeFileSync(path, await zip.generateAsync({type: 'nodebuffer'}))
+    let previousPath = ''
+    const socket = Bun.serve({hostname: '127.0.0.1', port: 0, fetch: () => new Response()})
+    const port = socket.port!
+    socket.stop()
+    for (const host of ['com.mentra.mentra', 'com.mentra.mentra.openalma']) {
+      const defaults = {baseUrl: 'http://test.example', userId: 'Test User',
+        deviceSessionId: host === 'com.mentra.mentra' ? 'stock-test' : 'android-test'}
+      const child = Bun.spawn([process.execPath, resolve(import.meta.dir, 'index.ts'),
+        'release', '--host', '127.0.0.1', '--port', String(port), '--bundle', path], {
+        cwd: dir, stdout: 'pipe', stderr: 'inherit',
+        env: {...process.env, MENTRA_RELEASE_DEFAULTS: JSON.stringify(defaults), MENTRA_RELEASE_HOST_PACKAGE: host},
+      })
+      try {
+        const reader = child.stdout.getReader()
+        let output = ''
+        while (!output.includes('Serving on')) {
+          const chunk = await reader.read()
+          if (chunk.done) throw new Error(`Installer exited: ${output}`)
+          output += new TextDecoder().decode(chunk.value)
+        }
+        const base = `http://127.0.0.1:${port}`
+        const uri = output.match(/miniapp:\/\/release\?[^\s]+/)![0]
+        const target = new URL(uri).searchParams.get('url')!
+        if (previousPath) expect((await fetch(`${base}${previousPath}/bundle.zip`)).status).toBe(404)
+        previousPath = new URL(target).pathname
+        const offerResponse = await fetch(`${base}/openalma-offer.json`)
+        expect((await fetch(`${base}/bundle.zip`)).status).toBe(404)
+        const served = await JSZip.loadAsync(await (await fetch(`${target}/bundle.zip`)).arrayBuffer())
+        const scope: Record<string, unknown> = {}
+        new Function('globalThis', await served.file(manifest.entry.background)!.async('string'))(scope)
+        expect(scope.loadedDefaults).toEqual(defaults)
+        expect((await fetch(`${base}/__mentra_release/installed`, {method: 'POST', body: JSON.stringify({offerId: 'wrong'})})).status)
+          .toBe(host === 'com.mentra.mentra' ? 404 : 409)
+        if (host === 'com.mentra.mentra') expect(offerResponse.status).toBe(404)
+        else {
+          const offer = await offerResponse.json()
+          expect(Object.keys(offer).sort()).toEqual(['deviceSessionId', 'offerId'])
+          expect(offer.deviceSessionId).toBe(defaults.deviceSessionId)
+          expect((await fetch(`${base}/__mentra_release/installed`, {method: 'POST', body: JSON.stringify({offerId: offer.offerId})})).status).toBe(200)
+        }
+      } finally {
+        child.kill('SIGINT')
+        await child.exited
+      }
+    }
+  } finally {
+    rmSync(dir, {recursive: true, force: true})
+  }
+})
