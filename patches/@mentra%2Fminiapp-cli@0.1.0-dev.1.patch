+import {expect, test} from 'bun:test'
+import {mkdtempSync, rmSync, writeFileSync} from 'fs'
+import {tmpdir} from 'os'
+import {join} from 'path'
+import JSZip from 'jszip'
+
+import {readReleaseBundle} from './release'
+
+test('reads identity and icon from a prebuilt release', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'mentra-release-'))
+  try {
+    const path = join(dir, 'bundle.zip')
+    const zip = new JSZip()
+    zip.file('miniapp.json', JSON.stringify({packageName: 'com.example.app', version: '1.2.3'}))
+    zip.file('icon.png', new Uint8Array([1, 2, 3]))
+    writeFileSync(path, await zip.generateAsync({type: 'uint8array'}))
+
+    const bundle = await readReleaseBundle(path)
+    expect(JSON.parse(bundle.manifestBuffer.toString())).toEqual({packageName: 'com.example.app', version: '1.2.3'})
+    expect(bundle.iconBuffer).toEqual(Buffer.from([1, 2, 3]))
+  } finally {
+    rmSync(dir, {recursive: true, force: true})
+  }
+})
