+
+export async function readReleaseBundle(path: string) {
+  if (!existsSync(path)) throw new Error(`Release bundle not found: ${path}`)
+  const zipBuffer = readFileSync(path)
+  const zip = await JSZip.loadAsync(zipBuffer)
+  const manifestFile = zip.file('miniapp.json')
+  if (!manifestFile) throw new Error('Release bundle is missing miniapp.json')
+  const manifestBuffer = Buffer.from(await manifestFile.async('uint8array'))
+  const iconFile = zip.file('icon.png')
+  return {
+    zipBuffer,
+    manifestBuffer,
+    iconBuffer: iconFile ? Buffer.from(await iconFile.async('uint8array')) : null,
+  }
+}
+
+export async function seedReleaseBundle(zipBuffer: Buffer, defaults: unknown): Promise<Buffer> {
+  const zip = await JSZip.loadAsync(zipBuffer)
+  const manifest = JSON.parse(await zip.file('miniapp.json')!.async('string'))
+  const background = typeof manifest.entry?.background === 'string' ? zip.file(manifest.entry.background) : null
+  if (!background) throw new Error('Release bundle is missing its background entry')
+  zip.file(manifest.entry.background,
+    `globalThis.__OPENALMA_INSTALL_DEFAULTS__ = ${JSON.stringify(defaults)};\n${await background.async('string')}`)
+  return zip.generateAsync({type: 'nodebuffer'})
 }

